#!/usr/bin/env python3
import argparse
from pathlib import Path
from subprocess import check_call

ROOT_DIR = Path(__file__).parents[1]


def format_size(size: int) -> str:
    return f"{size / 1024 / 1024:.02f} MB"


def format_size_change(source_size: int, target_size: int) -> str:
    ratio = target_size / source_size if target_size > 0 else 1.0
    return (
        f"{format_size(source_size)} → {format_size(target_size)}"
        f" ({ratio:.02%})"
    )


def iter_dir_names() -> list[str]:
    dir_names: list[str] = []
    for images_dir in sorted(ROOT_DIR.glob("*/images")):
        dir_name = images_dir.parent.name
        if (ROOT_DIR / dir_name / "ship/data/images").is_dir():
            dir_names.append(dir_name)
    return dir_names


def get_dir_pair(dir_name: str) -> tuple[Path, Path]:
    source_dir = ROOT_DIR / dir_name / "images"
    target_dir = ROOT_DIR / dir_name / "ship/data/images"
    if not source_dir.is_dir() or not target_dir.is_dir():
        raise ValueError(dir_name)
    return source_dir, target_dir


def get_dir_pairs(dir_name: str | None) -> list[tuple[Path, Path]]:
    if dir_name is not None:
        return [get_dir_pair(dir_name)]
    return [get_dir_pair(name) for name in iter_dir_names()]


def parse_args() -> argparse.Namespace:
    dir_names = iter_dir_names()
    parser = argparse.ArgumentParser(
        description="Converts image assets to WEBP format for better file sizes"
    )
    parser.add_argument(
        "dir",
        nargs="?",
        choices=dir_names,
        help="directory set to process (defaults to all)",
    )
    parser.add_argument(
        "quality",
        type=int,
        default=100,
        nargs="?",
        help="output quality (100 for lossless)",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="force overwrite existing files",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    dir_pairs = get_dir_pairs(args.dir)

    total_source_size = 0
    total_target_size = 0

    for source_dir, target_dir in dir_pairs:
        for source_path in source_dir.rglob("*.png"):
            target_path = target_dir / source_path.relative_to(
                source_dir
            ).with_suffix(".webp")
            target_path.parent.mkdir(parents=True, exist_ok=True)

            print(f"Converting {source_path} to {target_path}: ", end="")

            if target_path.exists() and not args.force:
                print("target already exists, skipping")
                continue

            check_call([
                "magick",
                str(source_path),
                "-resize",
                "x1200>",
                "-quality",
                str(args.quality),
                str(target_path),
            ])

            source_size = source_path.stat().st_size
            target_size = target_path.stat().st_size
            total_source_size += source_size
            total_target_size += target_size
            print(format_size_change(source_size, target_size))

    print()
    print("Total:")
    print("    " + format_size_change(total_source_size, total_target_size))


if __name__ == "__main__":
    main()
